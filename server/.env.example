# Server port
PORT=5000

# MongoDB connection string. If left empty/unreachable, the server falls back
# to an in-memory store so the app still runs without a database locally.
MONGO_URI=mongodb://127.0.0.1:27017/beacon-share

# URL of the frontend, used for CORS + Socket.IO origin checks
CLIENT_URL=http://localhost:5173

# Max upload size in megabytes
MAX_FILE_SIZE_MB=50
